{
  "db_path": "data/botlien.db",
  "board": { "port": 3230 },
  "engine": {
    "tick_ms": 15000,
    "eval_ms": 60000,
    "tick_timeout_ms": 20000,
    "rollup_bucket_ms": 3600000
  },
  "demo": { "scenario": "demo-fleet", "clock_scale": 60, "tick_real_ms": 1000 },
  "rules": {
    "offline_duration": { "warn_min": 30, "crit_min": 240, "clear_after_min": 10 },
    "error_severity": { "recur_count_24h": 5, "clear_after_min": 60 },
    "stuck_state": { "continuous_min": 10, "episodes_24h": 6, "clear_after_min": 30 },
    "utilization_drop": { "drop_pct": 40, "crit_drop_pct": 70, "baseline_floor_active_ms_per_day": 3600000, "clear_after_min": 720 },
    "battery_degradation": { "fade_pct": 15, "clear_after_min": 1440 },
    "connector_down": { "warn_min": 5, "crit_min": 30, "clear_after_min": 5 }
  },
  "bear": {
    "auth_url": "https://api-auth.bearrobotics.ai/authorizeApiAccess",
    "grpc_host": "api.bearrobotics.ai:443",
    "rest_base": "https://api.bearrobotics.ai/v1",
    "token_refresh_margin_min": 5
  }
}
