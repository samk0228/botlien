{
  "name": "botlien",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://nssxelgggpnaehgnbxwb.supabase.co"
  },
  "routes": [
    { "pattern": "botlien.com", "custom_domain": true },
    { "pattern": "www.botlien.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
