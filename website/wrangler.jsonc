{
  "name": "botlien",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "routes": [
    { "pattern": "botlien.com", "custom_domain": true },
    { "pattern": "www.botlien.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "botlien-analytics",
      "database_id": "10754e09-b218-499a-a39b-603340657307"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
